#!/bin/bash
# Shared machine setup, sourced by setup-minimal-ws and setup-full (also
# runnable directly). Everything here is wanted on every box, headless or
# desktop: distro detection (apt, or dnf/yum on the Red Hat side), core
# packages, git identity, docker, ~/bin + the ai-bullshit agent configs,
# and the franktheunicorn tools. Heavy toolchains (conda, sbt, spark pip
# deps) and desktop packages live in setup-full.
set -euo pipefail
set -x

# BASH_SOURCE so this resolves the repo even when sourced from another cwd.
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
  *debian*|*ubuntu*)
    FAMILY=debian
    PKG_UPDATE="sudo apt-get update"
    PKG_INSTALL="sudo apt-get install -y"
    EMACS_PKG=emacs-nox
    LIBSTDCXX_PKG=libstdc++6
    ;;
  *rhel*|*fedora*|*amzn*)
    FAMILY=rh
    # dnf on modern releases, yum on older RHEL/CentOS/Amazon Linux.
    if command -v dnf >/dev/null 2>&1; then
      PKG_UPDATE="sudo dnf makecache"
      PKG_INSTALL="sudo dnf install -y"
    else
      PKG_UPDATE="sudo yum makecache"
      PKG_INSTALL="sudo yum install -y"
    fi
    EMACS_PKG=emacs-nox
    LIBSTDCXX_PKG=libstdc++
    ;;
  *)
    echo "Unknown distro family: ID=${ID:-?} ID_LIKE=${ID_LIKE:-?}" >&2
    exit 1
    ;;
esac

$PKG_UPDATE
$PKG_INSTALL git curl python3 "$EMACS_PKG" "$LIBSTDCXX_PKG"

cp "$REPO/gitconfig" ~/.gitconfig
git config --global user.email "holden@pigscanfly.ca"
git config --global user.name "Holden Karau"
# New clones pick up git-templates/hooks/commit-msg (Spark co-author trailer).
git config --global init.templateDir "$REPO/git-templates"

# Docker: wanted on headless dev boxes too, not just desktops.
if [ "$FAMILY" = debian ]; then
  # Docker publishes ubuntu and debian separately, and plain Debian's codename
  # (bookworm) does not exist in the ubuntu repo -- picking the wrong one fails
  # at the next apt update, not here.
  case " ${ID:-} ${ID_LIKE:-} " in
    (*ubuntu*) DOCKER_DISTRO=ubuntu ;;
    (*)        DOCKER_DISTRO=debian ;;
  esac
  $PKG_INSTALL apt-transport-https ca-certificates curl gnupg
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL "https://download.docker.com/linux/$DOCKER_DISTRO/gpg" -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc

  sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/$DOCKER_DISTRO
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF

  $PKG_UPDATE
  $PKG_INSTALL docker-ce docker-ce-cli containerd.io
else
  $PKG_INSTALL docker
  sudo systemctl enable --now docker || true
fi
sudo usermod -aG docker "$USER"

# Symlink the helper scripts and agent configs into place. Fails loudly
# rather than overwriting if one of these already exists as a real file/dir.
ln -sfn "$REPO/bin" ~/bin
mkdir -p ~/.cursor ~/.claude
ln -sfn "$REPO/ai-bullshit/AGENTS.md" ~/AGENTS.md
ln -sfn "$REPO/ai-bullshit/cursor-rules" ~/.cursor/rules
ln -sfn "$REPO/ai-bullshit/cursor-hooks" ~/.cursor/hooks
ln -sfn "$REPO/ai-bullshit/cursor-hooks.json" ~/.cursor/hooks.json
ln -sfn "$REPO/ai-bullshit/claude/CLAUDE.md" ~/.claude/CLAUDE.md
ln -sfn "$REPO/ai-bullshit/claude/rules" ~/.claude/rules

# Java: default JAVA_HOME to a system Java 21 JDK when the box has one. A
# default, not a constraint -- the agent files say to check per branch.
#   21, not 25: branch-4.0 and branch-4.1 take 17/21 only and 25 is
#   master-only. (branch-3.5 is 8/11/17, hence SPARK35_JAVA_HOME below.)
#   A system JDK, not the nix one, for the JNI reason spelled out below.
# Only JAVA_HOME: leaving PATH alone means an existing nix/sdkman `java` keeps
# winning there, so `java -version` and $JAVA_HOME can disagree (which is why
# the agent note says to check both).
JDK_BUG_URL=https://bugs.openjdk.org/browse/JDK-8377811
JVM_DIR=${JVM_DIR:-/usr/lib/jvm}
# What the box hands every process before we touch anything. Worth keeping: the
# rc lines below only reach interactive shells, so this is still what an agent
# or a script inherits.
JAVA_HOME_INHERITED=${JAVA_HOME:-}

is_nix_jdk() {
  [ -n "${1:-}" ] || return 1
  case "$(readlink -f "$1/bin/java" 2>/dev/null)" in
    (/nix/store/*) return 0 ;;
  esac
  return 1
}

jdk_version() {
  # The java.version property, so we get 25.0.3 and not a whole banner line.
  [ -x "$1/bin/java" ] || return 1
  "$1/bin/java" -XshowSettings:properties -version 2>&1 \
    | awk -F'= ' '/^ *java\.version =/{print $2; exit}'
}

# The directory names differ by distro: temurin-21-jdk on the Red Hat side,
# temurin-21-jdk-arm64 (or -amd64) from Adoptium's apt repo, java-21-openjdk-*
# for Debian's own build. Glob wide and confirm with java.version rather than
# trusting the name.
find_jdk() {
  local feature="$1" d ver
  for d in "$JVM_DIR/temurin-$feature-jdk"* "$JVM_DIR"/*temurin*"$feature"* \
           "$JVM_DIR/java-$feature-openjdk"* "$JVM_DIR"/*"$feature"*; do
    [ -x "$d/bin/java" ] || continue
    ver=$(jdk_version "$d") || continue
    [ "${ver%%.*}" = "$feature" ] || continue
    printf '%s\n' "$d"
    return 0
  done
  return 1
}

check_jdk_for_spark() {
  local home="$1" how="$2" ver feature update
  ver=$(jdk_version "$home") || return 0
  [ -n "$ver" ] || return 0
  feature=${ver%%.*}
  case "$feature" in
    (""|*[^0-9]*) return 0 ;;   # 25-ea and friends: not ours to judge
  esac
  # -s matters: without it, `cut -d. -f3` on a dotless "25" returns "25", and a
  # bare Java 25 sails through the check below.
  update=$(printf '%s' "$ver" | cut -s -d. -f3)
  update=${update%%[^0-9]*}     # 1-beta -> 1, and empty for "25" or "25.0"
  update=${update:-0}
  # Java 25 below 25.0.3 hits JDK-8377811 (G1GC evacuates pinned objects).
  # Upstream banned it in SPARK-56843, so a build on one fails anyway -- fail
  # here, where the message can say why, instead of in every later build.
  # "update" is the third version component, matching Runtime.Version.update()
  # and therefore SparkBuild.scala's comparison exactly. A hypothetical 25.1.0
  # has update 0 and so is refused here too -- same as upstream would.
  if [ "$feature" = 25 ] && [ "$update" -lt 3 ]; then
    echo "already bad JDK version found for Spark development:" >&2
    echo "  Java $ver at $home ($how)" >&2
    echo "  Java 25 needs 25.0.3 or later. On 25.0.0-25.0.2 G1 can move pinned" >&2
    echo "  objects, which crashes JNI code (RocksDB, Arrow) at runtime." >&2
    echo "  $JDK_BUG_URL (banned upstream by SPARK-56843)" >&2
    echo "Other JDKs on this host, if any:" >&2
    # Unmatched globs stay literal, hence the -e guard.
    for d in /usr/lib/jvm/* ~/.sdkman/candidates/java/* /nix/store/*/bin/java; do
      if [ -e "$d" ]; then echo "  $d" >&2; fi
    done
    echo "Upgrade that JDK or point JAVA_HOME at a supported one, then re-run." >&2
    exit 1
  fi
  # 17.0.11 is java.minimum.version in Spark master's pom.xml. A warning only:
  # this box is not necessarily for Spark.
  if [ "$feature" -lt 17 ] || { [ "$feature" = 17 ] && [ "$update" -lt 11 ]; }; then
    echo "WARNING: Java $ver at $home ($how) is below Spark's 17.0.11 minimum" >&2
  fi
}

JDK_DEFAULT=$(find_jdk 21 || true)
# branch-3.5 tops out at Java 17. Nothing picks SPARK35_JAVA_HOME up on its own
# -- it is here so a 3.5 backport can say JAVA_HOME=$SPARK35_JAVA_HOME instead
# of going JDK hunting.
SPARK35_JDK=$(find_jdk 17 || true)

if [ -n "$JDK_DEFAULT" ]; then
  check_jdk_for_spark "$JDK_DEFAULT" "default JAVA_HOME"
  export JAVA_HOME="$JDK_DEFAULT"
else
  echo "no Java 21 JDK under $JVM_DIR; leaving JAVA_HOME=${JAVA_HOME:-unset} alone" >&2
  # Nothing of ours to set, so vet whatever the box already points at.
  [ -n "${JAVA_HOME:-}" ] && check_jdk_for_spark "$JAVA_HOME" "inherited JAVA_HOME"
fi
if [ -n "$SPARK35_JDK" ]; then
  check_jdk_for_spark "$SPARK35_JDK" "SPARK35_JAVA_HOME"
  export SPARK35_JAVA_HOME="$SPARK35_JDK"
else
  echo "no Java 17 JDK under $JVM_DIR; SPARK35_JAVA_HOME unset" >&2
fi

# Append to an rc that exists, or to one whose shell is installed. Marked, so
# re-running setup does not stack duplicates (the conda lines in setup-full do
# stack -- do not copy that). The block is delimited by both markers, not by a
# blank line: setup-full appends the conda lines straight after it with nothing
# between, and a delete-to-the-next-blank would take them with it.
if [ -n "$JDK_DEFAULT" ] || [ -n "$SPARK35_JDK" ]; then
  for shellrc in bashrc zshrc; do
    rc="$HOME/.$shellrc"
    [ -e "$rc" ] || command -v "${shellrc%rc}" >/dev/null 2>&1 || continue
    # Rewrite an existing block rather than skipping it: a box first set up when
    # these pointed at another JDK would otherwise keep pointing at it forever.
    # awk, not `sed -i '/x/,+1d'`, which is GNU-only and we have Macs. The
    # separator blank in front goes too, or a re-run stacks another one.
    if grep -qF "mydotfiles: JAVA_HOME" "$rc" 2>/dev/null; then
      # Delete only lines we recognise as ours, never a range. No scan for the
      # end marker: that has to look ahead, and a legacy block sitting above a
      # well-formed one would latch onto the LATER block's end marker and take
      # every user line between them. Anchored patterns, so a hand-written
      # comment that merely mentions the marker is not mistaken for it.
      # Invariant: every line the append below writes is matched by one of these.
      awk '
        function ours(s) {
          return s ~ /^\[ -d "/ \
              || s ~ /^# Nothing reads SPARK35_JAVA_HOME/ \
              || s ~ /^# mydotfiles: end JAVA_HOME/
        }
        { l[NR] = $0 }
        END {
          for (i = 1; i <= NR; i++) {
            if (l[i] == "" && l[i+1] ~ /^# mydotfiles: JAVA_HOME \(setup-shared\)/) continue
            if (l[i] ~ /^# mydotfiles: JAVA_HOME \(setup-shared\)/) {
              while (i + 1 <= NR && ours(l[i+1])) i++
              continue
            }
            print l[i]
          }
        }' "$rc" >"$rc.mydotfiles.tmp"
      mv "$rc.mydotfiles.tmp" "$rc"
    fi
    {
      printf '\n# mydotfiles: JAVA_HOME (setup-shared). Override per Spark branch as needed.\n'
      if [ -n "$JDK_DEFAULT" ]; then
        printf '[ -d "%s" ] && export JAVA_HOME="%s"\n' "$JDK_DEFAULT" "$JDK_DEFAULT"
      fi
      if [ -n "$SPARK35_JDK" ]; then
        printf '# Nothing reads SPARK35_JAVA_HOME on its own; it is the Java 17 for a 3.5 backport.\n'
        printf '[ -d "%s" ] && export SPARK35_JAVA_HOME="%s"\n' "$SPARK35_JDK" "$SPARK35_JDK"
      fi
      printf '# mydotfiles: end JAVA_HOME\n'
    } >>"$rc"
  done
fi

# RocksDB/LevelDB JNI needs libstdc++, and a nix JDK cannot find it. Its loader
# looks for a cache under its own prefix (/nix/store/...-glibc-*/etc/ld.so.cache)
# rather than /etc/ld.so.cache; that file does not exist, so it has no cache at
# all and falls back to the two dirs compiled into it -- nix's glibc and libgcc.
# Neither has libstdc++.so.6, and /lib64 is never consulted, so a native lib
# extracted from a jar (rocksdbjni, leveldbjni) fails to dlopen. Reads like a
# missing package and isn't. A system JDK has no such problem, which is what
# JAVA_HOME above points at -- so warn rather than "fix" it here.
# Do NOT export LD_LIBRARY_PATH=/lib64 to paper over it: that applies to every
# process and outranks each binary's RUNPATH, so nix binaries built against a
# newer glibc resolve libc.so.6 from /lib64 and die -- `xargs` included:
#   /lib64/libc.so.6: version `GLIBC_2.38' not found (required by xargs)
# The inherited value, not the one we just exported: ours is a system JDK by
# construction, so checking it would never say anything.
if is_nix_jdk "$JAVA_HOME_INHERITED"; then
  echo "WARNING: this box hands out JAVA_HOME=$JAVA_HOME_INHERITED, which is" >&2
  echo "  nix-provided (typically /etc/profile.d/java.sh). Its loader ignores" >&2
  echo "  /etc/ld.so.cache, so RocksDB/LevelDB JNI cannot dlopen libstdc++ and" >&2
  echo "  those suites fail with UnsatisfiedLinkError." >&2
  if [ "${JAVA_HOME:-}" != "$JAVA_HOME_INHERITED" ]; then
    echo "  The rc line above fixes interactive shells only. Anything that just" >&2
    echo "  inherits an environment -- agents, cron, \`ssh <host> <cmd>\` -- still" >&2
    echo "  gets the nix one, so set JAVA_HOME explicitly there." >&2
  else
    echo "  Point JAVA_HOME at a system JDK (/usr/lib/jvm/*) before building" >&2
    echo "  or testing Spark." >&2
  fi
fi

# franktheunicorn tools: clone and symlink everything in tools/ into ~/bin.
# ~/bin is a symlink into this repo, so the tool names are listed in
# .gitignore -- add new ones there when tools/ grows them.
FRANK_DIR=~/franktheunicorn
if [ -d "$FRANK_DIR/.git" ]; then
  git -C "$FRANK_DIR" pull --ff-only
else
  git clone https://github.com/franktheunicorn/franktheunicorn "$FRANK_DIR"
fi
for tool in "$FRANK_DIR"/tools/*; do
  [ -f "$tool" ] || continue
  chmod +x "$tool"
  ln -sfn "$tool" ~/bin/"$(basename "$tool")"
done

# add_coauthor.sh rewrites commit messages with git filter-repo.
if ! command -v git-filter-repo >/dev/null 2>&1; then
  $PKG_INSTALL git-filter-repo || python3 -m pip install --user git-filter-repo || \
    echo "WARNING: git-filter-repo not installed; add_coauthor.sh needs it" >&2
fi

# The cursor hooks are fail-closed: if the scripts are missing or not
# executable, every tool call is blocked. Git keeps the exec bit, but a
# checkout that loses it bricks the agent, so set it explicitly and smoke
# test each hook before declaring done.
chmod +x "$REPO/ai-bullshit/cursor-hooks/"*.sh
for hook in block-rm-rf block-secrets inject-global-rules; do
  out=$(echo '{}' | "$REPO/ai-bullshit/cursor-hooks/$hook.sh") || {
    echo "Hook $hook.sh failed to run -- fix this before using the agent" >&2
    exit 1
  }
  echo "$out" | python3 -c 'import json,sys; json.load(sys.stdin)' || {
    echo "Hook $hook.sh did not emit valid JSON" >&2
    exit 1
  }
done
