#!/usr/bin/env bash
# Hold 1 of N slots under /tmp/test-lock, run a command, release on exit.
# flock, not mkdir: a dead process drops the lock. Shared across Claude and Cursor.
set -euo pipefail

LOCK_DIR=/tmp/test-lock
# The shared protocol is 5 slots. Lowering your own ceiling is fine; raising it is
# not -- acquire() creates slot-5, slot-6 ... on demand, and every other user of
# this box only ever probes 0-4, so those holders are invisible to exactly the
# people the lock coordinates with.
MAX_SLOTS=5
SLOTS=$MAX_SLOTS
POLL_SECS=5

usage() {
  echo "usage: with-test-lock [--slots N] -- command [args...]   (N <= 5)" >&2
  echo "       with-test-lock [--slots N] --status" >&2
  exit 2
}

write_holder() {
  local slot="$1"
  shift
  printf 'slot=%s pid=%s user=%s cwd=%s started=%s cmd=%s\n' \
    "$slot" "$$" "$(id -un)" "$PWD" "$(date -Iseconds)" "$*" \
    >"$LOCK_DIR/slot-${slot}.holder"
}

clear_holder() {
  rm -f "$LOCK_DIR/slot-${1}.holder"
}

status() {
  mkdir -p "$LOCK_DIR"
  # MAX_SLOTS, not SLOTS: a lowered --slots would otherwise hide holders above it,
  # and hiding another user's build is the opposite of what this is for.
  local i
  for i in $(seq 0 $((MAX_SLOTS - 1))); do
    # A successful non-blocking flock means the slot is free.
    if flock -n "$LOCK_DIR/slot-$i" true 2>/dev/null; then
      rm -f "$LOCK_DIR/slot-${i}.holder"
      echo "slot $i: free"
    elif [[ -f "$LOCK_DIR/slot-${i}.holder" ]]; then
      echo "slot $i: $(cat "$LOCK_DIR/slot-${i}.holder")"
    else
      echo "slot $i: busy (no holder file)"
    fi
  done
}

acquired_fd=""
acquired_slot=""

acquire() {
  local i fd
  for i in $(seq 0 $((SLOTS - 1))); do
    exec {fd}>"$LOCK_DIR/slot-$i"
    if flock -n "$fd"; then
      acquired_fd="$fd"
      acquired_slot="$i"
      return 0
    fi
    exec {fd}>&-
  done
  return 1
}

WANT_STATUS=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)
      WANT_STATUS=1
      shift
      ;;
    --slots)
      # Guarded: bare --slots died on set -u with "$2: unbound variable"
      # instead of printing usage.
      [[ $# -ge 2 ]] || usage
      SLOTS="$2"
      [[ "$SLOTS" =~ ^[1-9][0-9]*$ ]] || usage
      if (( SLOTS > MAX_SLOTS )); then
        echo "with-test-lock: --slots $SLOTS exceeds the shared cap of $MAX_SLOTS;" >&2
        echo "  extra slots are invisible to everyone else on this box." >&2
        exit 2
      fi
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      ;;
    -*)
      echo "with-test-lock: unknown flag: $1" >&2
      usage
      ;;
    *)
      break
      ;;
  esac
done

if [[ "$WANT_STATUS" == 1 ]]; then
  # Refuse rather than silently drop the command someone also passed.
  if [[ $# -gt 0 ]]; then
    echo "with-test-lock: --status does not run a command (got: $*)" >&2
    exit 2
  fi
  status
  exit 0
fi

[[ $# -gt 0 ]] || usage

mkdir -p "$LOCK_DIR"

echo "with-test-lock: acquiring 1 of $SLOTS slots in $LOCK_DIR" >&2
if ! acquire; then
  echo "with-test-lock: all slots busy; holders:" >&2
  status >&2
  echo "with-test-lock: waiting for a slot to drop..." >&2
  while ! acquire; do
    sleep "$POLL_SECS"
  done
fi

trap 'clear_holder "$acquired_slot"' EXIT
write_holder "$acquired_slot" "$*"
echo "with-test-lock: got slot $acquired_slot" >&2

set +e
"$@"
rc=$?
set -e
echo "with-test-lock: releasing slot $acquired_slot (exit $rc)" >&2
exit "$rc"
