#!/bin/bash
# Shared machine setup, sourced by setup-minimal-ws and setup-full (also
# runnable directly). Everything here is wanted on every box, headless or
# desktop: distro detection (apt, or dnf/yum on the Red Hat side), core
# packages, git identity, docker, ~/bin + the ai-bullshit agent configs,
# and the franktheunicorn tools. Heavy toolchains (conda, sbt, spark pip
# deps) and desktop packages live in setup-full.
set -euo pipefail
set -x

# BASH_SOURCE so this resolves the repo even when sourced from another cwd.
REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)

. /etc/os-release
case " ${ID:-} ${ID_LIKE:-} " in
  *debian*|*ubuntu*)
    FAMILY=debian
    PKG_UPDATE="sudo apt-get update"
    PKG_INSTALL="sudo apt-get install -y"
    EMACS_PKG=emacs-nox
    ;;
  *rhel*|*fedora*|*amzn*)
    FAMILY=rh
    # dnf on modern releases, yum on older RHEL/CentOS/Amazon Linux.
    if command -v dnf >/dev/null 2>&1; then
      PKG_UPDATE="sudo dnf makecache"
      PKG_INSTALL="sudo dnf install -y"
    else
      PKG_UPDATE="sudo yum makecache"
      PKG_INSTALL="sudo yum install -y"
    fi
    EMACS_PKG=emacs-nw
    ;;
  *)
    echo "Unknown distro family: ID=${ID:-?} ID_LIKE=${ID_LIKE:-?}" >&2
    exit 1
    ;;
esac

$PKG_UPDATE
$PKG_INSTALL git curl python3 "$EMACS_PKG"

cp "$REPO/gitconfig" ~/.gitconfig
git config --global user.email "holden@pigscanfly.ca"
git config --global user.name "Holden Karau"
# New clones pick up git-templates/hooks/commit-msg (Spark co-author trailer).
git config --global init.templateDir "$REPO/git-templates"

# Docker: wanted on headless dev boxes too, not just desktops.
if [ "$FAMILY" = debian ]; then
  $PKG_INSTALL apt-transport-https ca-certificates curl gnupg
  sudo install -m 0755 -d /etc/apt/keyrings
  sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  sudo chmod a+r /etc/apt/keyrings/docker.asc

  sudo tee /etc/apt/sources.list.d/docker.sources <<EOF
Types: deb
URIs: https://download.docker.com/linux/ubuntu
Suites: $(. /etc/os-release && echo "${UBUNTU_CODENAME:-$VERSION_CODENAME}")
Components: stable
Signed-By: /etc/apt/keyrings/docker.asc
EOF

  $PKG_UPDATE
  $PKG_INSTALL docker-ce docker-ce-cli containerd.io
else
  $PKG_INSTALL docker
  sudo systemctl enable --now docker || true
fi
sudo usermod -aG docker "$USER"

# Symlink the helper scripts and agent configs into place. Fails loudly
# rather than overwriting if one of these already exists as a real file/dir.
ln -sfn "$REPO/bin" ~/bin
mkdir -p ~/.cursor ~/.claude
ln -sfn "$REPO/ai-bullshit/AGENTS.md" ~/AGENTS.md
ln -sfn "$REPO/ai-bullshit/cursor-rules" ~/.cursor/rules
ln -sfn "$REPO/ai-bullshit/cursor-hooks" ~/.cursor/hooks
ln -sfn "$REPO/ai-bullshit/cursor-hooks.json" ~/.cursor/hooks.json
ln -sfn "$REPO/ai-bullshit/claude/CLAUDE.md" ~/.claude/CLAUDE.md
ln -sfn "$REPO/ai-bullshit/claude/rules" ~/.claude/rules

# Java: default JAVA_HOME to the Temurin 25 JDK when the box has one. A
# default, not a constraint -- Spark branches differ on which JDKs they accept,
# and the agent files say to check per branch and override. Only JAVA_HOME:
# leaving PATH alone means an existing nix/sdkman `java` keeps winning there,
# so `java -version` and $JAVA_HOME can disagree (which is why the agent note
# says to check both).
JDK_DEFAULT=/usr/lib/jvm/temurin-25-jdk
JDK_BUG_URL=https://bugs.openjdk.org/browse/JDK-8377811

jdk_version() {
  # The java.version property, so we get 25.0.3 and not a whole banner line.
  [ -x "$1/bin/java" ] || return 1
  "$1/bin/java" -XshowSettings:properties -version 2>&1 \
    | awk -F'= ' '/^ *java\.version =/{print $2; exit}'
}

check_jdk_for_spark() {
  local home="$1" how="$2" ver feature update
  ver=$(jdk_version "$home") || return 0
  [ -n "$ver" ] || return 0
  feature=${ver%%.*}
  case "$feature" in
    (""|*[^0-9]*) return 0 ;;   # 25-ea and friends: not ours to judge
  esac
  # -s matters: without it, `cut -d. -f3` on a dotless "25" returns "25", and a
  # bare Java 25 sails through the check below.
  update=$(printf '%s' "$ver" | cut -s -d. -f3)
  update=${update%%[^0-9]*}     # 1-beta -> 1, and empty for "25" or "25.0"
  update=${update:-0}
  # Java 25 below 25.0.3 hits JDK-8377811 (G1GC evacuates pinned objects).
  # Upstream banned it in SPARK-56843, so a build on one fails anyway -- fail
  # here, where the message can say why, instead of in every later build.
  # "update" is the third version component, matching Runtime.Version.update()
  # and therefore SparkBuild.scala's comparison exactly. A hypothetical 25.1.0
  # has update 0 and so is refused here too -- same as upstream would.
  if [ "$feature" = 25 ] && [ "$update" -lt 3 ]; then
    echo "already bad JDK version found for Spark development:" >&2
    echo "  Java $ver at $home ($how)" >&2
    echo "  Java 25 needs 25.0.3 or later. On 25.0.0-25.0.2 G1 can move pinned" >&2
    echo "  objects, which crashes JNI code (RocksDB, Arrow) at runtime." >&2
    echo "  $JDK_BUG_URL (banned upstream by SPARK-56843)" >&2
    echo "Other JDKs on this host, if any:" >&2
    # Unmatched globs stay literal, hence the -e guard.
    for d in /usr/lib/jvm/* ~/.sdkman/candidates/java/* /nix/store/*/bin/java; do
      if [ -e "$d" ]; then echo "  $d" >&2; fi
    done
    echo "Upgrade that JDK or point JAVA_HOME at a supported one, then re-run." >&2
    exit 1
  fi
  # 17.0.11 is java.minimum.version in Spark master's pom.xml. A warning only:
  # this box is not necessarily for Spark.
  if [ "$feature" -lt 17 ] || { [ "$feature" = 17 ] && [ "$update" -lt 11 ]; }; then
    echo "WARNING: Java $ver at $home ($how) is below Spark's 17.0.11 minimum" >&2
  fi
}

if [ -d "$JDK_DEFAULT" ]; then
  check_jdk_for_spark "$JDK_DEFAULT" "$JDK_DEFAULT"
  export JAVA_HOME="$JDK_DEFAULT"
  # Append to an rc that exists, or to one whose shell is installed. Guarded by
  # a marker so re-running setup does not stack duplicates (the conda lines in
  # setup-full do stack -- do not copy that).
  for shellrc in bashrc zshrc; do
    rc="$HOME/.$shellrc"
    [ -e "$rc" ] || command -v "${shellrc%rc}" >/dev/null 2>&1 || continue
    if ! grep -qF "mydotfiles: JAVA_HOME" "$rc" 2>/dev/null; then
      cat >>"$rc" <<EOF

# mydotfiles: JAVA_HOME (setup-shared). Override per Spark branch as needed.
[ -d "$JDK_DEFAULT" ] && export JAVA_HOME="$JDK_DEFAULT"
EOF
    fi
  done
else
  echo "no $JDK_DEFAULT; leaving JAVA_HOME=${JAVA_HOME:-unset} alone" >&2
  # Nothing of ours to set, so vet whatever the box already points at.
  [ -n "${JAVA_HOME:-}" ] && check_jdk_for_spark "$JAVA_HOME" "inherited JAVA_HOME"
fi

# franktheunicorn tools: clone and symlink everything in tools/ into ~/bin.
# ~/bin is a symlink into this repo, so the tool names are listed in
# .gitignore -- add new ones there when tools/ grows them.
FRANK_DIR=~/franktheunicorn
if [ -d "$FRANK_DIR/.git" ]; then
  git -C "$FRANK_DIR" pull --ff-only
else
  git clone https://github.com/franktheunicorn/franktheunicorn "$FRANK_DIR"
fi
for tool in "$FRANK_DIR"/tools/*; do
  [ -f "$tool" ] || continue
  chmod +x "$tool"
  ln -sfn "$tool" ~/bin/"$(basename "$tool")"
done

# add_coauthor.sh rewrites commit messages with git filter-repo.
if ! command -v git-filter-repo >/dev/null 2>&1; then
  $PKG_INSTALL git-filter-repo || python3 -m pip install --user git-filter-repo || \
    echo "WARNING: git-filter-repo not installed; add_coauthor.sh needs it" >&2
fi

# The cursor hooks are fail-closed: if the scripts are missing or not
# executable, every tool call is blocked. Git keeps the exec bit, but a
# checkout that loses it bricks the agent, so set it explicitly and smoke
# test each hook before declaring done.
chmod +x "$REPO/ai-bullshit/cursor-hooks/"*.sh
for hook in block-rm-rf block-secrets inject-global-rules; do
  out=$(echo '{}' | "$REPO/ai-bullshit/cursor-hooks/$hook.sh") || {
    echo "Hook $hook.sh failed to run -- fix this before using the agent" >&2
    exit 1
  }
  echo "$out" | python3 -c 'import json,sys; json.load(sys.stdin)' || {
    echo "Hook $hook.sh did not emit valid JSON" >&2
    exit 1
  }
done
