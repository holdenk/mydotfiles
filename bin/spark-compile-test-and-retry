#!/usr/bin/env python3
"""
spark-compile-test-and-retry -- build + test a Spark branch before pushing.

Run from anywhere inside a Spark worktree. Rebuilds the JVM side, runs the
suites to completion, then re-runs each failed test on its own so flakes and
real failures don't get reported as the same thing.

What to run comes from the branch's own dev/sparktestsupport/modules.py, the
module graph, goals and -P profiles CI and dev/run-tests plan from, so it is
right on every branch. Four speeds:
  default       what PR CI runs: every module the diff touches plus every
                module depending on one, full suites. A core or build change
                maps to everything. Hours to days.
  --everything  every SBT module and every PySpark goal, doctests included.
                Days.
  --modules     every suite in the modules the diff touches (hours)
  --fast        only the suites derived from the diff, for when Holden said
                she is in a hurry
Explicit suite specs override the speed flags.

One sbt at a time per worktree: two race on compile output. Whole-module runs
share ONE `sbt all a/test b/test ...`, which runs modules concurrently up to
SparkBuild's 4 forked test JVMs. Diff-derived suites share one sbt boot per
module; sbt aborts the rest of a multi-command invocation on a failure, so
never-started suites get re-batched. PySpark modules spread over up to --jobs
lanes: lane 1 always runs, extra lanes only start a test while the test lock
has 2+ free slots, and every test takes and drops its own slot.

Semi-resilient: a failing suite does not stop the run, a crashed SBT gets
one do-over, and everything lands in target/compile-test-and-retry-logs/<ts>/.
Each failed test is retried exactly ONCE (scala retries batched per module).
Fails twice -> real failure, and there is no flag to re-roll it further:
something that flakes twice is something to look at.

Not done on purpose: scalastyle/lint, R, docs build, MIMA (spark-presend
covers lint; the rest is CI's job). If the diff is doc-only the script says
so and exits 0 -- that is the intended exemption, in every speed.

Usage:
  spark-compile-test-and-retry                    # build + what PR CI runs
  spark-compile-test-and-retry --everything       # build + ALL the tests
  spark-compile-test-and-retry --fast             # build + diff-derived suites
  spark-compile-test-and-retry --modules          # build + touched modules' suites
  spark-compile-test-and-retry --build-only       # just the build the plan needs
  spark-compile-test-and-retry '*RocksDBSuite*'   # explicit scala suite glob
  spark-compile-test-and-retry sql/'*RocksDBSuite*'  # explicit module + glob
  spark-compile-test-and-retry pyspark.sql.tests.test_udf_transpile_unit
  spark-compile-test-and-retry --skip-build --dry-run
"""

import argparse
import json
import os
import re
import resource
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path

# Sibling of this script (resolves through the ~/bin symlink), so moving
# the mydotfiles checkout never stales this.
LOCK_HELPER = str(Path(__file__).resolve().parent / "with-test-lock")
# One source of truth for "which JDK does THIS branch accept" -- see resolve_jdk().
JDK_HELPER = str(Path(__file__).resolve().parent / "set_spark_jdk_to_ok")
DOC_ONLY = re.compile(
    r"(^docs/|^\.github/|^dev/|^LICENSE|^NOTICE|\.md$|\.rst$|\.markdown$)")
BUILD_FILES = re.compile(r"(^|/)pom\.xml$|^project/|^build\.sbt$|^build/")
# Known SBT module ids, from BuildCommons in project/SparkBuild.scala, plus
# whatever the branch's modules.py names a test goal for (see load_ci). Used to
# sanity-check the artifactId-derived guess, not as the source of truth.
KNOWN_MODULES = {
    "core", "graphx", "mllib", "mllib-local", "repl", "network-common",
    "network-shuffle", "launcher", "unsafe", "tags", "sketch", "kvstore",
    "common-utils", "common-utils-java", "variant", "pipelines", "config",
    "sql-api", "catalyst", "sql", "hive", "hive-thriftserver",
    "token-provider-kafka-0-10", "sql-kafka-0-10", "avro", "protobuf",
    "streaming", "streaming-kafka-0-10", "connect-common", "connect",
    "connect-client-jdbc", "connect-client-jvm", "connect-shims",
    "udf-worker-proto", "udf-worker-core", "udf-worker-grpc",
    "kubernetes", "yarn", "hadoop-cloud", "assembly", "examples", "tools",
}

# sbt prints suite headers with the SIMPLE class name ([info] FooSuite:),
# not the FQCN -- 2320 headers in a real run, zero dotted. No name-suffix
# filter either: 5 of those 2320 end in neither Suite/Test/Benchmark/Spec
# (ParquetDeltaEncodingLong, ...), and header-shaped non-suite lines do not
# occur in practice.
SUITE_HDR = re.compile(r"^\[info\] ([\w$]+(?:\.[\w$]+)*):\s*$")
TEST_FAIL = re.compile(r"^\[info\] - (.*?) \*\*\* FAILED \*\*\*")
# A whole suite aborted (crashed JVM, OOM in the runner). Suite-level only:
# the FQCN token keeps a test-level "- name *** ABORTED ***" (an assume()
# skip) from reading as a dead suite.
SUITE_ABORT = re.compile(r"^\[info\] ([\w$.]+) \*\*\* ABORTED \*\*\*")
# sbt prints this when the test task FINISHES, even with failed or aborted
# suites: [error] (hive / Test / test) sbt.TestsFailedException ... (testOnly
# for single-suite runs). Its absence on a red run means sbt or the forked
# JVM died mid-module and every suite after that point never ran.
TASK_END = re.compile(r"^\[error\] \(\S+ / Test / test(?:Only)?\) ")
# ...and this when it finishes green. Read from a module's own task log.
TEST_SUMMARY = re.compile(r"^\[info\] (?:Passed: Total|No tests to run)")
FAILED_SUITE_LINE = re.compile(r"^\[error\] \t([\w$]+(?:\.[\w$]+)+)\s*$")
COMPILE_FAIL = re.compile(r"Compilation failed|error compiling")
PY_FAIL = re.compile(r"^(?:FAIL|ERROR): (\w+) \(([\w.]+)\)")

# The hypothesis suite is gated: without RUN_HYPOTHESIS=1, 19 of 23 tests
# skip and the run looks green in ~5s. That is not a green.
HYPOTHESIS_ENV = {"RUN_HYPOTHESIS": "1", "RUN_HYPOTHESIS_MAX_EXAMPLES": "200"}

# Needs a docker daemon, and CI only enables it on GitHub Actions anyway.
SKIP_SBT_MODULES = {"docker-integration-tests"}

# python/run-tests' heavy-first order: these prefixes are the long modules.
HEAVY_PY = ("pyspark.streaming.tests", "pyspark.mllib.tests", "pyspark.tests",
            "pyspark.sql.tests", "pyspark.ml.tests", "pyspark.pandas.tests")

# An extra lane takes a test only while this many test-lock slots are free.
HEADROOM = 2

# sbt test runs print at least every 5 minutes while a test runs (SparkBuild's
# ScalaTest -W 120 300), and a dead forked JVM leaves sbt hung rather than
# failed (verified by halting one). Silence this long means hung.
SBT_IDLE = 3600

NOW = time.strftime("%Y%m%d-%H%M%S")


def say(msg):
    print(f"[ctar {time.strftime('%H:%M:%S')}] {msg}", flush=True)


def die(msg, code=2):
    say(f"FATAL: {msg}")
    sys.exit(code)


class Item:
    """One runnable test unit: a scala suite glob in an SBT module, or a
    python unittest spec / doctest module."""

    def __init__(self, kind, module, pattern, why, env_extra=None, doctest=False):
        self.kind = kind            # "scala" | "py"
        self.module = module        # sbt module id | n/a for py
        self.pattern = pattern      # testOnly glob | dotted unittest spec
        self.why = why
        self.env_extra = env_extra or {}
        # A modules.py goal that is not a test_* module: its doctests run as
        # `python -m <module>`. `-m unittest` would find no TestCase and pass.
        self.doctest = doctest
        # Batch runs fill this with the suite patterns that never started
        # (abort/timeout), so phase 3 reports them instead of a silent green.
        self.unrun = []

    def name(self):
        if self.kind == "scala":
            if self.pattern == "--all--":
                return f"{self.module}/all-suites"
            if self.pattern == "--batch--":
                return f"{self.module}/batched-suites"
            return f"{self.module}/{self.pattern}"
        return self.pattern

    def cmd(self, runner):
        """Whole-module items have none: they run in run_scala_modules.
        PySpark goes through bin/pyspark, as python/run-tests does: under
        SPARK_TESTING it runs `$PYSPARK_DRIVER_PYTHON -m ...` with
        PYTHONHASHSEED=0 (or every string-hashing doctest dies) and the
        YARN/Hadoop conf dirs unset."""
        if self.kind == "scala":
            return runner.sbt(f"{self.module}/testOnly {self.pattern}")
        if self.doctest:
            return ["bin/pyspark", self.pattern]
        return ["bin/pyspark", "unittest", self.pattern]


def find_root():
    try:
        root = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True).stdout.strip()
    except subprocess.CalledProcessError:
        die("not inside a git worktree")
    if not (Path(root) / "project" / "SparkBuild.scala").exists():
        die(f"{root} does not look like a Spark worktree (no project/SparkBuild.scala)")
    return root


def find_venv_python(root):
    for cand in (Path(root) / ".venv" / "bin" / "python",
                 Path.home() / "spark" / ".venv" / "bin" / "python"):
        if cand.exists():
            return str(cand)
    return shutil.which("python3") or die("no python found")


def scan_modules(root, known):
    """Map SBT module id -> module dir, by walking for pom.xml and applying
    the spark-<artifactId>_2.13 -> id rule. Prunes target/.git/.venv."""
    modules = {}
    root_p = Path(root)
    for dirpath, dirnames, filenames in os.walk(root_p):
        dirnames[:] = [d for d in dirnames
                       if d not in ("target", ".git", ".venv", "dist", "node_modules")]
        if "pom.xml" not in filenames:
            continue
        d = Path(dirpath)
        try:
            txt = (d / "pom.xml").read_text(errors="replace")[:6000]
        except OSError:
            continue
        txt = re.sub(r"<parent>.*?</parent>", "", txt, flags=re.S)
        m = re.search(r"<artifactId>(?:spark-)?([A-Za-z0-9\-]+?)(?:_[0-9.]+)?</artifactId>", txt)
        if not m:
            continue
        mod = m.group(1)
        if mod in known and mod not in modules:
            modules[mod] = d
    return modules


def module_for_path(root, modules, relpath):
    """Longest module dir that is a prefix of relpath."""
    best = None
    for mod, d in modules.items():
        try:
            Path(relpath).relative_to(d.relative_to(root))
        except ValueError:
            continue
        if best is None or len(str(d)) > len(str(modules[best])):
            best = mod
    return best


def discover_scala_suites(modules, mod, stem):
    """Find *Suite/*Test classes in a module whose names start with stem.
    Capped at 10: a one-letter stem from a renamed file is a bad derivation,
    not a reason to run half the module."""
    d = modules.get(mod)
    if d is None:
        return []
    found = set()
    for td in ("src/test/scala", "src/test/java"):
        base = d / td
        if not base.exists():
            continue
        for pat in (f"{stem}Suite", f"{stem}Tests", f"{stem}Test", f"{stem}*Suite"):
            for f in base.rglob(pat + ".*"):
                if f.suffix in (".scala", ".java"):
                    found.add(f.stem)
    return sorted(found)[:10]


def py_dotted(root, path):
    # Git hands us relative paths, rglob hands us absolute ones.
    p = Path(path)
    if not p.is_absolute():
        p = Path(root) / p
    return ".".join(p.relative_to(root).with_suffix("").parts[1:])


def discover_py_modules(root, relpath):
    """Map a changed python file to test modules. A changed test module maps
    to itself; a source file maps to test_<stem>.py anywhere under python/."""
    p = Path(relpath)
    if p.parts[0] != "python" or p.suffix != ".py" or "__pycache__" in p.parts:
        return []
    if p.name.startswith("test_"):
        return [py_dotted(root, p)]
    stem = p.stem
    out = []
    for f in sorted((Path(root) / "python").rglob(f"test_{stem}.py")):
        if "__pycache__" not in f.parts:
            out.append(py_dotted(root, f))
    return out


def base_ref(root, requested):
    if requested:
        return requested
    for cand in ("upstream/master", "origin/master", "master"):
        if subprocess.run(["git", "rev-parse", "--verify", "--quiet", cand],
                          cwd=root, capture_output=True).returncode == 0:
            return cand
    die("no upstream/master, origin/master or master ref to diff against; use --base")


def changed_files(root, base):
    mb = subprocess.run(["git", "merge-base", "HEAD", base],
                        cwd=root, capture_output=True, text=True)
    if mb.returncode != 0:
        die(f"git merge-base HEAD {base} failed: {mb.stderr.strip()}")
    mb = mb.stdout.strip()
    # --diff-filter=d drops deleted files: there is nothing to map to a
    # suite, and a deleted test file would otherwise derive a suite run for
    # code that no longer exists.
    diff = subprocess.run(["git", "diff", "--name-only", "--diff-filter=d", mb],
                          cwd=root, capture_output=True, text=True, check=True).stdout
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        cwd=root, capture_output=True, text=True, check=True).stdout
    files = sorted({*diff.splitlines(), *untracked.splitlines()} - {""})
    return mb, files


def py_item(root, tf, why):
    """A py Item for a test_*.py path, with the gated-suite env attached
    where needed."""
    env = HYPOTHESIS_ENV if "hypothesis" in Path(tf).name else None
    return Item("py", None, py_dotted(root, tf), why, env)


def py_spec_item(spec, why, doctest=False):
    """Same for an already-dotted unittest spec (which is not a path, so
    py_item/py_dotted do not apply)."""
    env = HYPOTHESIS_ENV if "hypothesis" in spec else None
    return Item("py", None, spec, why, env, doctest)


def load_ci(root):
    """The branch's own dev/sparktestsupport -- what CI and dev/run-tests plan
    from. Same API from branch-3.5 through master."""
    dev = Path(root) / "dev"
    if not (dev / "sparktestsupport" / "modules.py").exists():
        die(f"{dev}/sparktestsupport/modules.py is missing; it is what this "
            "script plans from")
    sys.path.insert(0, str(dev))
    try:
        import sparktestsupport.modules as ci
        import sparktestsupport.utils as ci_utils
    except Exception as e:
        die(f"cannot import {dev}/sparktestsupport: {e}")
    return ci, ci_utils


def sbt_profiles(ci):
    """sbt id -> the -P flags CI tests it with. hive-thriftserver, yarn,
    network-yarn, kubernetes and hadoop-cloud are not sbt projects at all
    without theirs, so a -Phive-only run cannot even name them."""
    out = {}
    for m in ci.all_modules:
        for g in m.sbt_test_goals:
            if g.endswith("/test"):
                out.setdefault(g[:-len("/test")], set()).update(m.build_profile_flags)
    return out


def is_doctest_goal(goal):
    return not goal.rsplit(".", 1)[-1].startswith("test_")


def dangling_py_tests(root, ci, files):
    """Changed test_*.py files no modules.py goal names (CI's own rule,
    Module.missing_potential_python_test). Every plan built from modules.py
    skips them; master's CI fails the PR over them, and older branches' CI
    never runs them at all."""
    goals = ci.root.python_test_goals
    return [f for f in files
            if re.fullmatch(r"test_.*\.py", Path(f).name) and (Path(root) / f).exists()
            and not any(".".join(Path(f).parts)[:-3].endswith(g) for g in goals)]


def plan_ci(ci, ci_utils, code, mode):
    """Whole-module plan from modules.py. mode: "everything", "default" (the
    touched modules plus their dependents -- CI's own selection) or "modules"
    (touched only)."""
    notes = []
    if mode == "everything":
        mods = [ci.root]
    else:
        mods = ci_utils.determine_modules_for_files(code)
        if mode == "default":
            mods = ci_utils.determine_modules_to_test(mods)
        elif ci.root in mods:
            notes.append("files no CI module claims (CI would run everything) "
                         "are skipped by --modules")
            mods = [m for m in mods if m is not ci.root]
    if ci.root in mods:
        mods = [m for m in ci.all_modules if m is not ci.root]
    sbt, py = {}, {}
    for m in sorted(mods, key=lambda m: m.name):
        for g in m.sbt_test_goals:
            if not g.endswith("/test"):
                continue
            mod = g[:-len("/test")]
            if mod in SKIP_SBT_MODULES:
                notes.append(f"{mod}: needs docker; not run")
            else:
                sbt.setdefault(mod, m.name)
        for g in m.python_test_goals:
            py.setdefault(g, m.name)
    items = [Item("scala", mod, "--all--", why) for mod, why in sbt.items()]
    items += [py_spec_item(g, why, is_doctest_goal(g)) for g, why in py.items()]
    return items, notes


# The import-graph relevance check Spark's own CI applies on apache/spark
# pushes (pyspark/testing/utils.py, PYSPARK_CHANGED_FILES), done once up front
# so an irrelevant module never even launches. Exit 3: no grimp in the venv.
GRIMP_PRUNE = r"""
import json, sys
try:
    import grimp
except ImportError:
    sys.exit(3)
changed, goals = json.load(sys.stdin)
graph = grimp.build_graph("pyspark")
def relevant(m):
    try:
        return any(m == c or graph.chain_exists(m, c) for c in changed)
    except Exception:
        return True  # not in the graph: run it
json.dump([m for m in goals if relevant(m)], sys.stdout)
"""


def prune_py_by_imports(root, venv_py, code, items, notes):
    """Python-only diff: drop the unittest modules that import nothing it
    touched. PR CI from a fork does not prune, so this runs less than PR CI;
    --everything keeps them all. Doctest modules always run, as in Spark."""
    if not all(f.startswith("python/pyspark/") and f.endswith(".py") for f in code):
        return items
    goals = [it.pattern for it in items if it.kind == "py" and not it.doctest]
    if not goals:
        return items
    changed = [f[len("python/"):-len(".py")].replace("/", ".").removesuffix(".__init__")
               for f in code]
    try:
        p = subprocess.run([venv_py, "-c", GRIMP_PRUNE], cwd=root,
                           input=json.dumps([changed, goals]), capture_output=True,
                           text=True, timeout=900,
                           env=dict(os.environ, PYTHONPATH=str(Path(root) / "python")))
    except subprocess.TimeoutExpired:
        notes.append("import-graph pruning timed out; running every PySpark module")
        return items
    if p.returncode == 3:
        notes.append("no grimp in the venv; not pruning PySpark modules by imports")
        return items
    if p.returncode != 0:
        err = (p.stderr.strip().splitlines() or ["?"])[-1]
        notes.append(f"import-graph pruning failed ({err}); running them all")
        return items
    keep = set(json.loads(p.stdout))
    notes.append(f"python-only diff: {len(goals) - len(keep)} of {len(goals)} "
                 "PySpark test modules import nothing it touched; skipped "
                 "(--everything runs them)")
    return [it for it in items
            if it.kind != "py" or it.doctest or it.pattern in keep]


def plan_from_diff(root, modules, files, doctests):
    """--fast: suites derived from the changed files' names. doctests is the
    set of modules.py doctest goals, so a changed module with doctests runs
    them too."""
    items, notes = [], []
    seen = {}

    def add(item):
        key = (item.kind, item.module, item.pattern)
        if key in seen:
            # An env-carrying item (gated suite) beats the bare one: the
            # self-mapped test module and the transpile block reach the same
            # suite, and only one of them sets RUN_HYPOTHESIS.
            if item.env_extra and not seen[key].env_extra:
                items[items.index(seen[key])] = item
                seen[key] = item
            return
        seen[key] = item
        items.append(item)

    code = [f for f in files if not DOC_ONLY.search(f)]
    if any(BUILD_FILES.search(f) for f in files):
        notes.append("build files changed: the build step covers compilation; "
                     "consider --modules if build logic itself changed")
    transpile_touched = any("transpile" in f and f.startswith("python/") for f in code)

    for f in code:
        if f.endswith((".scala", ".java")):
            mod = module_for_path(root, modules, f)
            if mod is None:
                notes.append(f"no SBT module found for {f}; skipped")
                continue
            stem = Path(f).stem
            is_test = "/src/test/" in f
            if is_test and re.search(r"(Suite|Tests?|Benchmark)$", stem):
                add(Item("scala", mod, f"*{stem}", f))
            else:
                suites = discover_scala_suites(modules, mod, stem)
                if not suites:
                    notes.append(f"no suites matching {stem}* in {mod} (from {f})")
                for s in suites:
                    add(Item("scala", mod, f"*{s}", f))
                if not is_test:
                    notes.append(f"{f} is not a test; running {len(suites)} name-matched suite(s)")
        elif f.startswith("python/") and f.endswith(".py"):
            mods = discover_py_modules(root, f)
            if py_dotted(root, f) in doctests:
                add(py_spec_item(py_dotted(root, f), f, doctest=True))
            elif not mods:
                notes.append(f"no test_<stem> module found for {f}; skipped")
            for m in mods:
                # py_spec_item, not a bare Item: m is already dotted, and this
                # was the one py construction site that skipped the helper, so
                # it never attached the gate env. A hypothesis-named module whose
                # path lacks "transpile" would run with 19 of 23 tests skipped
                # and look green in 5s. add()'s "env-carrying item wins" merge
                # only papers over that while exactly one such suite exists.
                add(py_spec_item(m, f))
        else:
            notes.append(f"not mapped to tests: {f}")

    if transpile_touched:
        for f in sorted((Path(root) / "python" / "pyspark" / "sql" / "tests").glob(
                "test_udf_transpile*.py")):
            add(py_item(root, f, "transpile"))
    return items, notes


def suite_class_declared(d, stem_glob):
    """A test-class declaration matching the glob exists under d's test
    trees. testOnly globs match CLASS names, and Spark has suites whose
    class name differs from the file name (ShuffleNettyNioSuite lives in
    ShuffleNettySuite.scala), so file-name matching alone rejects real
    suites. Content-greps every test file: fine for a CLI one-off, too slow
    as a first check."""
    rx = re.compile(r"^\s*(?:abstract\s+)?(?:final\s+)?class\s+"
                    + re.escape(stem_glob).replace(r"\*", ".*").replace(r"\?", ".")
                    + r"[\s(]", re.M)
    for td in ("src/test/scala", "src/test/java"):
        base = d / td
        if not base.exists():
            continue
        for ext in ("*.scala", "*.java"):
            for f in base.rglob(ext):
                try:
                    if rx.search(f.read_text(errors="replace")):
                        return True
                except OSError:
                    continue
    return False


def resolve_explicit(root, modules, spec):
    """Turn a command-line spec into Items."""
    if spec.startswith("py:"):
        return [py_spec_item(spec[3:], "cli")]
    if spec.startswith("pyspark."):
        return [py_spec_item(spec, "cli")]
    if "/" in spec:
        mod, pat = spec.split("/", 1)
        if mod not in modules:
            die(f"unknown SBT module '{mod}' in spec '{spec}'")
        # sbt exits 0 on "No tests to run", so a typo'd glob is a silent
        # green unless the glob names at least one test file. FQCN patterns
        # (sql/org.apache.spark.sql.RocksDBSuite) are legal testOnly specs;
        # check existence on the simple name.
        check = pat.rsplit(".", 1)[-1] if "." in pat else pat
        stem_glob = check if "*" in check else f"{check}*"
        d = modules[mod]
        hits = [f for td in ("src/test/scala", "src/test/java")
                if (d / td).exists()
                for f in (d / td).rglob(f"{stem_glob}.*")
                if f.suffix in (".scala", ".java")]
        if not hits and not suite_class_declared(d, stem_glob):
            die(f"no test files or classes matching '{stem_glob}' under "
                f"{mod}/src/test; sbt would exit 0 on 'No tests to run' "
                "and call that green")
        return [Item("scala", mod, pat, "cli")]
    if spec.startswith("test_"):
        hits = [f for f in (Path(root) / "python").rglob(f"{spec}.py")
                if "__pycache__" not in f.parts]
        if not hits:
            die(f"no python test module matching '{spec}'")
        return [py_item(root, h, "cli") for h in sorted(hits)]
    # Bare scala glob, e.g. '*RocksDBSuite*' or 'RocksDBSuite'.
    stem_glob = spec if "*" in spec else f"{spec}*"
    out = []
    for mod, d in sorted(modules.items()):
        for td in ("src/test/scala", "src/test/java"):
            base = d / td
            if not base.exists():
                continue
            for f in base.rglob(f"{stem_glob}.*"):
                if f.suffix in (".scala", ".java") and \
                        re.search(r"(Suite|Tests?)$", f.stem):
                    out.append(Item("scala", mod, f"*{f.stem}", "cli"))
    if not out:
        die(f"no scala suites matching '{spec}' in any module")
    # Same class name can exist in only one module in practice; dedupe.
    uniq = {(i.module, i.pattern): i for i in out}
    return list(uniq.values())


# --- execution -------------------------------------------------------------

class Runner:
    def __init__(self, root, logdir, suite_timeout_min, heap, profiles, venv_py, echo_py):
        self.root = root
        self.logdir = logdir
        self.timeout = suite_timeout_min * 60
        self.profiles = profiles
        self.venv_py = venv_py
        self.echo_py = echo_py
        self.env = os.environ.copy()
        for k in ("AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN"):
            # Empty string is not enough: the guard is keyId != null. Genuinely unset.
            self.env.pop(k, None)
        self.env.update({
            "SPARK_HOME": root,
            "SPARK_LOCAL_IP": "127.0.0.1",
            "SPARK_LOCAL_HOSTNAME": "localhost",
            "SPARK_TESTING": "1",
        })
        if heap:
            self.env["HEAP_SIZE"] = heap
        # Before any per-test TMPDIR: unix socket paths cap near 108 chars, so
        # they stay off the deep per-test dirs (python/run-tests does the same).
        self.sock_dir = os.environ.get("TMPDIR") or "/tmp"
        self.py_tmp = logdir / "py-tmp"
        self.procs = set()
        self.procs_lock = threading.Lock()

    def sbt(self, *cmds):
        return ["build/sbt", *self.profiles, *cmds]

    def env_for(self, item):
        """(env, per-test tmp dir or None). PySpark gets python/run-tests'
        isolation, which is what makes its --parallelism safe and so the
        lanes here: own TMPDIR, java.io.tmpdir and warehouse dir."""
        env = dict(self.env)
        env.update(item.env_extra)
        if item.kind != "py":
            return env, None
        self.py_tmp.mkdir(parents=True, exist_ok=True)
        tmp = Path(tempfile.mkdtemp(dir=self.py_tmp))
        java = f"-Djava.io.tmpdir={tmp} -Xss4M"
        log4j = Path(self.root) / "python" / "test_support" / "log4j2.properties"
        if log4j.exists():
            java += f" -Dlog4j.configurationFile={log4j}"
        env.update({
            "PYTHONPATH": str(Path(self.root) / "python"),
            "PYSPARK_PYTHON": self.venv_py,
            "PYSPARK_DRIVER_PYTHON": self.venv_py,
            "PYTHONUNBUFFERED": "1",
            # Tests that shell out to a bare `python` must get this one.
            "PATH": f"{Path(self.venv_py).parent}:{self.env['PATH']}",
            "TMPDIR": str(tmp),
            # Keep RocksDB SST/changelog IO on the worktree disk, not the
            # shared 50G /tmp loop device.
            "SPARK_LOCAL_DIRS": str(tmp),
            "PYSPARK_SUBMIT_ARGS": " ".join([
                "--conf", f"spark.driver.extraJavaOptions='{java}'",
                "--conf", f"spark.executor.extraJavaOptions='{java}'",
                "--conf", f"spark.sql.warehouse.dir='{tmp / 'warehouse'}'",
                "--conf", f"spark.python.unix.domain.socket.dir={self.sock_dir}",
                "pyspark-shell"]),
        })
        return env, tmp

    def run(self, cmd, logfile, env, timeout=None, echo=True, idle=None):
        """Run cmd under the shared lock, output to logfile and, with echo, to
        stdout (never pipe through tail/grep: a hung job must look hung).
        idle kills a run silent that long once it holds its slot."""
        timeout = timeout or self.timeout
        # env_checks has already verified LOCK_HELPER exists.
        full = [LOCK_HELPER, "--"] + cmd
        say("+ " + " ".join(cmd) + f"   [log: {logfile}]")
        finished = threading.Event()
        why = []
        last = [None]  # last output time; None while still queued for a slot
        with open(logfile, "a") as lf:
            lf.write(f"$ {' '.join(cmd)}\n")
            p = subprocess.Popen(
                full, cwd=self.root, env=env, stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT, text=True, bufsize=1,
                start_new_session=True)
            with self.procs_lock:
                self.procs.add(p)

            def watchdog():
                deadline = time.time() + timeout
                while not finished.wait(30):
                    if time.time() > deadline:
                        why.append(f"after {timeout // 60}min")
                    elif idle and last[0] and time.time() - last[0] > idle:
                        why.append(f"silent for {idle // 60}min")
                    else:
                        continue
                    try:
                        os.killpg(p.pid, signal.SIGKILL)
                    except ProcessLookupError:
                        pass
                    return

            t = threading.Thread(target=watchdog, daemon=True)
            t.start()
            try:
                for line in p.stdout:
                    if last[0] or line.startswith("with-test-lock: got slot"):
                        last[0] = time.time()
                    if echo:
                        sys.stdout.write(line)
                        sys.stdout.flush()
                    lf.write(line)
                rc = p.wait()
            finally:
                finished.set()
                with self.procs_lock:
                    self.procs.discard(p)
        if why:
            say(f"TIMEOUT ({why[0]}): {' '.join(cmd)}")
            return -signal.SIGKILL, True
        if not echo:
            say(f"{'ok' if rc == 0 else f'rc={rc}'}: {logfile.name}")
        return rc, False

    def kill_all(self):
        with self.procs_lock:
            procs = list(self.procs)
        for p in procs:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass


# --- failure parsing ---------------------------------------------------------

def parse_scala_failures(logfile, start=0):
    """Return (failed [(suite, test)], suite_level [fqcn], compile_failed).

    start is a byte offset: only output from there on is parsed, so one
    batch round can attribute failures to itself without earlier rounds'
    failures confusing it."""
    failed, suite_level, compile_failed = [], [], False
    current_suite = None
    try:
        with open(logfile, errors="replace") as f:
            if start:
                f.seek(start)
                f.readline()  # the offset may split a line
            for line in f:
                m = SUITE_HDR.match(line)
                if m:
                    current_suite = m.group(1)
                m = TEST_FAIL.match(line)
                if m and current_suite:
                    failed.append((current_suite, m.group(1)))
                m = SUITE_ABORT.match(line)
                if m:
                    suite_level.append(m.group(1))
                if COMPILE_FAIL.search(line):
                    compile_failed = True
                m = FAILED_SUITE_LINE.match(line)
                if m:
                    suite_level.append(m.group(1))
    except OSError:
        pass
    return failed, sorted(set(suite_level)), compile_failed


def parse_py_failures(logfile):
    out = []
    try:
        with open(logfile, errors="replace") as f:
            for line in f:
                m = PY_FAIL.match(line)
                if m:
                    # unittest.loader._FailedTest means the module itself did
                    # not import; there is no individual test to retry.
                    # 3.11+ suffixes the module (._FailedTest.test_foo), so
                    # an exact match alone is dead there.
                    if m.group(2) == "unittest.loader._FailedTest" or \
                            m.group(2).startswith("unittest.loader._FailedTest."):
                        continue
                    modcls, test = m.group(2), m.group(1)
                    # Python 3.11+ prints (module.Class.test); 3.9 prints
                    # (module.Class). Normalize to (module.Class, test).
                    if modcls.endswith("." + test):
                        modcls = modcls[: -(len(test) + 1)]
                    out.append((modcls, test))
    except OSError:
        pass
    return out


# Anchored to a whole line: the runner logs the command line itself
# ("$ build/sbt ... eval println(\"CTAR-BEGIN-0\") ..."), and an unanchored
# match would read phantom markers off it.
BATCH_MARK = re.compile(r"^CTAR-BEGIN-(\d+)\s*$")


def started_commands(logfile):
    """Marker indices of the batched commands sbt STARTED in this log.

    An `eval println("CTAR-BEGIN-<k>")` precedes each testOnly in the batch,
    so "command k started" is directly observable. Inferring it from suite
    headers does not work: the glob '*StateStoreSuite' also matches
    RocksDBStateStoreSuite's header, so a suite that never ran can look
    started (and its skip would go green).
    """
    out = set()
    try:
        with open(logfile, errors="replace") as f:
            for line in f:
                m = BATCH_MARK.match(line)
                if m:
                    out.add(int(m.group(1)))
    except OSError:
        pass
    return out


def run_scala_batch(runner, mod, patterns, logfile, env, retry=False):
    """Run a module's testOnly patterns as ONE sbt invocation instead of one
    boot per suite (a boot is minutes; a fast-mode diff can name a handful,
    and phase 3 has one pattern per failed test).

    sbt aborts the remaining commands when one fails (verified: marker after
    a failing command never prints, exit rc 1), so a failing suite would
    silently skip the rest of the batch. Markers make the abort point exact:
    sbt only advances past a command that succeeded, so every command before
    the last started one completed green, the last started one failed, and
    everything after it never ran and gets re-batched. A round with no
    progress at all means sbt itself died: one whole-batch do-over, same as
    the single-suite rule. A command that died with no parseable failure (sbt
    or its JVM crashed) runs again -- unless this is a retry, which gets
    exactly one go.

    Returns ({pattern: "ok" | "failed" | "unrun"}, timed_out).
    """
    status = {}
    pending = list(dict.fromkeys(patterns))
    timed_out, do_overs, marker_base = False, 1, 0
    while pending:
        cmds = []
        for i, p in enumerate(pending):
            cmds.append(f'eval println("CTAR-BEGIN-{marker_base + i}")')
            cmds.append(f"{mod}/testOnly {p}")
        # Per-suite timeout times the batch size, capped like a module run.
        timeout = min(len(pending) * runner.timeout, 8 * 3600)
        log_pos = os.path.getsize(logfile) if os.path.exists(logfile) else 0
        rc, timed_out = runner.run(runner.sbt(*cmds), logfile, env,
                                   timeout=timeout, idle=SBT_IDLE)
        # Marker indices are unique across rounds via marker_base; the range
        # check rejects a test that prints a marker-shaped line. The log
        # accumulates every round's output for phase 3's failure parsing,
        # but attribution reads only this round's slice: a re-batched suite
        # that fails AGAIN (an over-matching glob already ran it once) still
        # belongs to this round's last started command.
        started = {k - marker_base for k in started_commands(logfile)
                   if marker_base <= k < marker_base + len(pending)}
        marker_base += len(pending)
        if rc == 0:
            status.update(dict.fromkeys(pending, "ok"))
            break
        last = max(started) if started else None
        if last is not None:
            status.update(dict.fromkeys(pending[:last], "ok"))
        failed, suite_level, compile_failed = parse_scala_failures(
            logfile, start=log_pos)
        if compile_failed or timed_out:
            # Nothing after a compile failure runs, and a timed-out suite's
            # results are partial at best: phase 3 reports them either way,
            # never a silent green.
            state = "failed" if compile_failed else "unrun"
            status.update(dict.fromkeys(pending[last or 0:], state))
            say(f"{mod}: {'compile failed' if compile_failed else 'timed out'}; "
                "not re-batching")
            break
        if last is None:
            rest = list(pending)  # sbt died before command 0
        elif failed or suite_level or retry:
            status[pending[last]] = "failed"
            rest = pending[last + 1:]
        else:
            rest = pending[last:]
        if not rest:
            break
        if len(rest) == len(pending):
            if do_overs:
                do_overs -= 1
                say(f"{mod}: sbt died before any suite finished; "
                    f"one whole-batch do-over")
                continue
            status.update(dict.fromkeys(pending, "unrun"))
            say(f"{mod}: sbt died twice before any suite finished; giving up")
            break
        say(f"{mod}: sbt aborted mid-batch; re-batching {len(rest)} suite(s)")
        pending = rest
    return status, timed_out


def module_task_log(moddir):
    """sbt's own log of a module's test task. `all` interleaves modules on the
    console; this file holds the one module's output, task-end line included
    (verified), so the single-module parsers work on it unchanged."""
    return (Path(moddir) / "target" / "streams" / "test" / "test" / "_global"
            / "streams" / "out")


def run_scala_modules(runner, modules, items, logdir, env):
    """Whole test phases in ONE sbt process: `all a/test b/test ...` runs the
    modules concurrently, capped by SparkBuild's 4 forked test JVMs -- the cap
    one hive/test already hits alone, so a slot's peak load does not move.

    Verdicts come from each module's task log, copied into logdir: the task-end
    line means it finished red, sbt's Passed/No-tests summary green. Neither
    after sbt died gets one do-over, all such modules in one more `all`. Neither
    after a timeout -- including the idle kill that ends the hang a dead forked
    JVM leaves, which fires only once every other module has gone quiet --
    means never finished, as a timed-out module always did.
    Returns [(item, rc, timed_out, logfile)], like the other runs."""
    out, pending = [], list(items)
    for attempt in (1, 2):
        start = time.time()
        console = logdir / f"sbt-all-modules{'-do-over' if attempt == 2 else ''}.log"
        # A module run gets 8h, as before; four run at a time.
        timeout = min(8 * 3600 * -(-len(pending) // 4), 24 * 3600)
        rc, timed_out = runner.run(
            runner.sbt("all " + " ".join(f"{it.module}/test" for it in pending)),
            console, env, timeout=timeout, idle=SBT_IDLE)
        compile_failed = parse_scala_failures(console)[2]
        unknown = []
        for it in pending:
            src = module_task_log(modules[it.module])
            log = logdir / f"{it.module}-tests.log"
            fresh = src.exists() and src.stat().st_mtime >= start
            if fresh:
                shutil.copyfile(src, log)
            lines = log.read_text(errors="replace").splitlines() if fresh else []
            if any(TASK_END.match(l) for l in lines):
                out.append((it, 1, False, log))
            elif rc == 0 or any(TEST_SUMMARY.match(l) for l in lines):
                out.append((it, 0, False, log if fresh else console))
            elif compile_failed:
                out.append((it, rc, False, console))  # phase 3 reports it
            elif timed_out or attempt == 2:
                it.unrun = ["its test phase ("
                            + ("timed out" if timed_out else "no verdict twice") + ")"]
                out.append((it, 0, timed_out, console))
            else:
                unknown.append(it)
        if not unknown:
            break
        say(f"no verdict from sbt for {[it.module for it in unknown]}; one do-over")
        pending = unknown
    return out


def free_slots():
    try:
        return int(subprocess.run([LOCK_HELPER, "--free"], capture_output=True,
                                  text=True, timeout=60).stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return 0


def run_lanes(units, jobs):
    """Run units, [(priority, fn)], on up to `jobs` threads, lowest priority
    first; returns the fn() results in unit order. Lane 1 always works (each
    run still queues in with-test-lock like anyone's). Extra lanes take a unit
    only while the lock has HEADROOM free slots, so a quiet box gets the
    parallelism and a busy one gets a single lane."""
    todo = sorted(range(len(units)), key=lambda i: units[i][0])
    results = [None] * len(units)
    mu = threading.Lock()

    def lane(extra):
        while True:
            if extra and free_slots() < HEADROOM:
                with mu:
                    if not todo:
                        return
                time.sleep(30)
                continue
            with mu:
                if not todo:
                    return
                i = todo.pop(0)
            try:
                results[i] = units[i][1]()
            except BaseException as e:  # re-raised below, on the main thread
                results[i] = e

    threads = [threading.Thread(target=lane, args=(n > 0,), daemon=True)
               for n in range(max(1, min(jobs, len(units))))]
    for t in threads:
        t.start()
    for t in threads:
        while t.is_alive():
            t.join(1)  # a bare join() would sit out a Ctrl-C
    for r in results:
        if isinstance(r, BaseException):
            raise r
    return results


# --- environment checks ---------------------------------------------------------

def jdk_version(java_home):
    """java.version for a JDK directory, or None if it has no runnable java.
    os.access, not exists(): a root-owned or half-extracted JDK has a bin/java
    that cannot be run.
    javac too: a JRE-only tree (Debian's openjdk-21-jre-headless creates one)
    reports a fine java.version and then fails every build with "Unable to
    locate a Java Compiler"."""
    java = Path(java_home) / "bin" / "java"
    if not os.access(java, os.X_OK) or not os.access(Path(java_home) / "bin" / "javac", os.X_OK):
        return None
    try:
        p = subprocess.run([str(java), "-XshowSettings:properties", "-version"],
                           capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        # A wedged java binary (hung NFS home, broken loader) must not hang
        # the whole preflight.
        return None
    m = re.search(r"^\s*java\.version = (\S+)", p.stdout + p.stderr, re.M)
    return m.group(1) if m else None


def is_nix_jdk(java_home):
    try:
        return str((Path(java_home) / "bin" / "java").resolve()).startswith("/nix/store/")
    except OSError:
        return False


def jdk_feature(ver):
    """Feature version from a java.version string. 1.8.0_392 -> 8, 17.0.16 -> 17.
    The legacy 1.N scheme matters: a naive leading-digit parse reads both Java 7
    and Java 8 as feature 1 and collides them."""
    m = re.match(r"1\.(\d+)", ver or "") or re.match(r"(\d+)", ver or "")
    return int(m.group(1)) if m else None


def any_system_jdk():
    """A runnable JDK for the fallback when set_spark_jdk_to_ok could not answer.
    Applies no per-branch rule -- it only gets us off a nix JDK, which is wrong on
    every branch -- so it prefers the feature version with the widest acceptance:
    17 is taken by master, 4.0, 4.1 AND 3.5, where 25 is master-only. Then 21,
    then the newest of whatever else. Never below 17: no Spark branch since 3.0
    accepts one, so offering a Java 8 as the fix would be a lie.

    Searches the same places set_spark_jdk_to_ok does, not just /usr/lib/jvm --
    Path.glob on a missing directory returns [] in silence, so a Mac or an
    sdkman-only box would otherwise find nothing and stay on the nix JDK."""
    roots = [Path(os.environ.get("JVM_DIR") or "/usr/lib/jvm"),
             Path.home() / ".sdkman" / "candidates" / "java",
             Path("/Library/Java/JavaVirtualMachines")]
    by_feature = {}
    for root in roots:
        for d in sorted(root.glob("*")):
            # macOS keeps the real home a level down.
            home = d if (d / "bin" / "java").exists() else d / "Contents" / "Home"
            feat = jdk_feature(jdk_version(home))
            if feat is not None and feat >= 17:
                by_feature.setdefault(feat, str(home))
    for feat in (17, 21):
        if feat in by_feature:
            return by_feature[feat]
    return by_feature[max(by_feature)] if by_feature else None


def resolve_jdk(root):
    """Pin JAVA_HOME to a JDK THIS worktree accepts, and keep it off nix.

    Delegated to set_spark_jdk_to_ok so the rule lives in one place: it reads
    docs/index.md, pom.xml's java.minimum.version and SparkBuild's version veto
    out of the branch in front of it. The copy that used to be here hardcoded
    master's rule and applied it everywhere, which misfired both ways -- it
    warned that a supported 17.0.9 "will fail in checkJavaVersion" on
    branch-3.5, which has no checkJavaVersion at all, and it would repoint a
    4.0/4.1 worktree onto a system Java 25 those branches do not accept.

    build/sbt takes $JAVA_HOME/bin/java whenever that is executable
    (sbt-launch-lib.bash:22), so this is the java that does the build and the
    only one worth reporting. And a nix JDK's loader looks for its cache under
    its own prefix, never finds libstdc++, so rocksdbjni/leveldbjni cannot
    dlopen and every state-store suite dies with UnsatisfiedLinkError -- better
    to find that out now than three hours into a run.
    """
    if os.access(JDK_HELPER, os.X_OK):
        try:
            p = subprocess.run([JDK_HELPER], cwd=root, capture_output=True,
                               text=True, timeout=120)
        except subprocess.TimeoutExpired:
            p = None
            say(f"{Path(JDK_HELPER).name} timed out after 120s")
        if p is not None:
            for line in p.stdout.splitlines():
                if line.startswith("export JAVA_HOME="):
                    home = line.split("=", 1)[1].strip()
                    os.environ["JAVA_HOME"] = home
                    return home, jdk_version(home) or "?"
            say(f"{Path(JDK_HELPER).name} could not pick a JDK for this branch:")
            for line in p.stderr.strip().splitlines()[-4:]:
                say(f"  {line}")
        # Say it plainly. Without the helper there is no per-branch rule here, so
        # whatever JAVA_HOME holds may well be one this branch rejects -- and the
        # nix repoint below only covers nix, while setup-shared's default is a
        # SYSTEM Java 21 that a branch-3.5 worktree refuses.
        say("  so JAVA_HOME is unchecked against this branch; if the compile dies "
            "in checkJavaVersion, that is why")
    else:
        say(f"{JDK_HELPER} is missing; not checking the JDK against this branch")
    # Fallback: no per-branch rule available, so only the thing that is true on
    # every branch -- a nix JDK cannot load the JNI libs.
    home = os.environ.get("JAVA_HOME") or ""
    if not home or not os.access(Path(home) / "bin" / "java", os.X_OK):
        found = shutil.which("java")
        if not found:
            die("no usable JAVA_HOME and no java on PATH")
        home = str(Path(found).resolve().parent.parent)
        os.environ["JAVA_HOME"] = home
    if is_nix_jdk(home):
        # Actually move off it, do not just warn. The helper declining (a
        # branch-3.5 worktree on a 21/25-only box, say) must not leave the run on
        # a nix JDK -- every RocksDB/LevelDB/state-store suite then dies with
        # UnsatisfiedLinkError hours in, which is the thing this function exists
        # to catch early.
        alt = any_system_jdk()
        if alt:
            say(f"JAVA_HOME was nix-provided ({home}); using {alt} instead -- a "
                "nix JDK cannot dlopen libstdc++ for RocksDB/LevelDB JNI. It may "
                "not be one this branch accepts; check if the suites complain.")
            home = alt
            os.environ["JAVA_HOME"] = home
        else:
            say(f"WARNING: JAVA_HOME={home} is nix-provided and /usr/lib/jvm has "
                "no usable JDK; RocksDB/LevelDB suites will fail to load their "
                "native libs")
    return home, jdk_version(home) or "?"


def env_checks(root, venv_py, need_py):
    java_home, java_ver = resolve_jdk(root)
    if need_py:
        # A wrong-interpreter venv is the same lie as a stale jar. The shared
        # venv broke once already when an OS update moved /usr/bin/python3
        # (3.12 -> 3.9) under it; check, don't assume.
        probe = subprocess.run([venv_py, "-c", "import py4j"],
                               capture_output=True, text=True)
        if probe.returncode != 0:
            die(f"{venv_py} cannot import py4j -- the shared venv is broken "
                f"(check .venv/bin/python3 symlink vs pyvenv.cfg version): "
                f"{probe.stderr.strip().splitlines()[-1] if probe.stderr else '?'}")
    if not os.path.exists(LOCK_HELPER):
        die(f"{LOCK_HELPER} is missing -- it ships next to this script in "
            "the dotfiles repo, so its absence means a broken checkout. The "
            "lock is what keeps concurrent test JVMs from timing each other "
            "out on this shared box; running unlocked is not a fallback.")
    # RocksDB JNI extracts librocksdbjni.so into java.io.tmpdir and execs it.
    # That is under <root>/target for every test JVM here: SparkBuild's
    # testTempDir for SBT suites, Runner.env_for's per-test dirs for PySpark.
    # So a noexec worktree disk is a hard fail, not a surprise later.
    # mkstemp, not a fixed name: two concurrent runs must not unlink each
    # other's probe mid-exec.
    tmp = Path(root) / "target" / "tmp"
    tmp.mkdir(parents=True, exist_ok=True)
    fd, probe = tempfile.mkstemp(dir=tmp, prefix=".ctar-exec-check-")
    try:
        with os.fdopen(fd, "w") as pf:
            pf.write("#!/bin/sh\nexit 0\n")
        os.chmod(probe, 0o700)
        if subprocess.run([probe], capture_output=True).returncode != 0:
            die(f"{tmp} exists but failed to exec a probe script")
    except OSError as e:
        die(f"{tmp} is noexec or broken ({e}); RocksDB native loading will fail")
    finally:
        Path(probe).unlink(missing_ok=True)
    # InetAddress.getLocalHost() must return a usable address: whatever calls
    # it (SparkHadoopUtil when AWS_* are set, some suites directly) dies with
    # UnknownHostException on a host whose name resolves only to link-local
    # IPv6. The runner env unsets the AWS trigger, so warn rather than die.
    # getent is not a faithful probe (nss-myhostname hands it the link-local
    # answer Java's resolver rejects), so ask Java itself.
    geth_dir = Path(tempfile.mkdtemp(prefix="ctar-geth-"))
    try:
        geth = geth_dir / "Geth.java"
        geth.write_text(
            "public class Geth { public static void main(String[] a) "
            "throws Exception { java.net.InetAddress h = "
            "java.net.InetAddress.getLocalHost(); "
            "if (h.isLinkLocalAddress()) System.exit(2); "
            "System.out.println(h); } }\n")
        r = subprocess.run([str(Path(java_home) / "bin" / "java"), str(geth)],
                           capture_output=True, text=True, timeout=120)
        if r.returncode != 0:
            say(f"WARNING: InetAddress.getLocalHost() is unusable here "
                f"(rc={r.returncode}: threw, or returned a link-local "
                f"address); anything calling it breaks (S3 creds in the env, "
                f"some suites). Fix: '127.0.1.1 {socket.gethostname()}' in "
                f"/etc/hosts (setup-shared does this).")
    except (OSError, subprocess.TimeoutExpired) as e:
        say(f"WARNING: getLocalHost probe could not run: {e}")
    finally:
        shutil.rmtree(geth_dir, ignore_errors=True)
    free_gb = shutil.disk_usage(root).free / (1 << 30)
    if free_gb < 15:
        say(f"WARNING: only {free_gb:.0f}G free on the worktree filesystem; "
            "RocksDB suites write GBs of SSTs")
    # State store suites open a lot of files; raise soft nofile toward hard.
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    if soft < 8192:
        try:
            resource.setrlimit(resource.RLIMIT_NOFILE, (min(hard, 65536), hard))
        except (ValueError, OSError):
            say(f"WARNING: nofile soft limit is {soft} and could not be raised")
    ps = subprocess.run(["ps", "-ef"], capture_output=True, text=True).stdout
    orphans = [l for l in ps.splitlines()
               if ("run-tests" in l or "testOnly" in l) and str(os.getpid()) not in l
               and "grep" not in l and "compile-test-and-retry" not in l]
    if orphans:
        say("WARNING: possible leftover test processes (they hold no lock but "
            "confuse ps output):")
        for l in orphans[:5]:
            say(f"  {l.strip()}")
    # JAVA_HOME, not PATH's java: sbt follows the former (build/sbt-launch-lib).
    say(f"env ok: java={java_ver} at {java_home}")
    say(f"env ok: python={venv_py}")


def safe_name(s):
    return re.sub(r"[^\w.-]+", "_", s)


def run_py(runner, it, logfile):
    """One PySpark module (or a retry spec, as an Item). The per-test tmp dir
    goes on success and stays on failure, next to the logs."""
    env, tmp = runner.env_for(it)
    rc, timed_out = runner.run(it.cmd(runner), logfile, env, echo=runner.echo_py)
    if rc == 0:
        shutil.rmtree(tmp, ignore_errors=True)
    return rc, timed_out


def main():
    ap = argparse.ArgumentParser(
        prog="spark-compile-test-and-retry",
        description="Build + test a Spark branch before pushing. "
                    "Resilient: collects all failures, then re-runs each failed "
                    "test individually to separate flakes from real failures.")
    ap.add_argument("specs", nargs="*",
                    help="suites: '*RocksDBSuite*', sql/'*FooSuite*', "
                         "pyspark.sql.tests.test_foo, py:test_foo, or bare test_foo")
    speed = ap.add_mutually_exclusive_group()
    speed.add_argument("--fast", action="store_true",
                       help="only the suites derived from the diff, for when "
                            "in a hurry; the default is what PR CI runs")
    speed.add_argument("--modules", action="store_true",
                       help="all suites in every module the diff touches "
                            "(hours); the middle speed")
    speed.add_argument("--everything", action="store_true",
                       help="every SBT module and every PySpark goal (days)")
    build = ap.add_mutually_exclusive_group()
    build.add_argument("--skip-build", action="store_true",
                       help="skip the build (only if the jar is current)")
    build.add_argument("--build-only", action="store_true",
                       help="run just the build this plan needs, then stop "
                            "(spark-presend overlaps it with lint)")
    ap.add_argument("--dry-run", action="store_true",
                    help="print the plan and the exact commands, run nothing")
    ap.add_argument("--jobs", type=int, default=3, metavar="N",
                    help="max concurrent test processes: one sbt plus PySpark "
                         "lanes (default 3). Lanes past the first only run while "
                         "the test lock has 2+ free slots; 1 is fully serial")
    ap.add_argument("--suite-timeout", type=int, default=90, metavar="MIN",
                    help="per-suite timeout in minutes (default 90; whole-module "
                         "runs get 8h)")
    ap.add_argument("--base", help="diff base ref (default: upstream/master, "
                                   "then origin/master, then master)")
    ap.add_argument("--heap", help="HEAP_SIZE for SBT test JVMs (build default 4g)")
    args = ap.parse_args()
    if args.jobs < 1:
        ap.error("--jobs must be >= 1")

    root = find_root()
    venv_py = find_venv_python(root)
    ci, ci_utils = load_ci(root)
    profile_map = sbt_profiles(ci)
    modules = scan_modules(root, KNOWN_MODULES | set(profile_map))
    if not modules:
        die("no modules found (no pom.xml files?) -- is this a full Spark checkout?")

    branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                            cwd=root, capture_output=True, text=True).stdout.strip()
    base = base_ref(root, args.base)
    mb, files = changed_files(root, base)
    if (len(files) > 500 and not args.specs and not args.base
            and not args.everything):
        die(f"{len(files)} changed files vs {base} -- the auto-detected base is "
            "almost certainly wrong (release branch diffed against master?). "
            "Re-run with --base <release-branch> or pass explicit suites.")

    logdir = Path(root) / "target" / "compile-test-and-retry-logs" / NOW
    logdir.mkdir(parents=True, exist_ok=True)

    say(f"worktree: {root}  branch: {branch}")
    say(f"base: {base} (merge-base {mb[:12]}), {len(files)} changed file(s)")
    say(f"logs: {logdir}")

    dangling = [] if args.specs else dangling_py_tests(root, ci, files)
    if dangling:
        die(f"no dev/sparktestsupport/modules.py goal names {', '.join(dangling)}; "
            "register each in its module's python_test_goals (master's CI fails "
            "the PR over this, and older branches' CI never runs them)")

    notes = []
    if args.specs:
        items = []
        for spec in args.specs:
            items.extend(resolve_explicit(root, modules, spec))
    elif not files:
        say("empty diff and no suites given: nothing to test. Done.")
        return 0
    else:
        code = [f for f in files if not DOC_ONLY.search(f)]
        if not code:
            say("doc-only diff: nothing to test. Done.")
            return 0
        if args.fast:
            doctests = {g for g in ci.root.python_test_goals if is_doctest_goal(g)}
            items, notes = plan_from_diff(root, modules, files, doctests)
        else:
            mode = ("everything" if args.everything
                    else "modules" if args.modules else "default")
            items, notes = plan_ci(ci, ci_utils, code, mode)
            if mode != "everything":
                items = prune_py_by_imports(root, venv_py, code, items, notes)

    for n in notes:
        say(f"note: {n}")
    if not items:
        say("no test suites resolved from the diff; nothing to run. Done.")
        return 0

    profiles = ["-Phive"] + sorted(
        {f for it in items if it.kind == "scala"
         for f in profile_map.get(it.module, ())} - {"-Phive"})
    py_items = [it for it in items if it.kind == "py"]
    mod_items = [it for it in items if it.kind == "scala" and it.pattern == "--all--"]
    # Diff-derived/explicit scala suites: ONE sbt boot per module.
    scala_groups = {}
    for it in items:
        if it.kind == "scala" and it.pattern != "--all--":
            # Repeated CLI specs ('sql/*Foo* sql/*Foo*') would run the suite
            # twice; the batch gains nothing from a duplicate pattern.
            group = scala_groups.setdefault(it.module, [])
            if all(g.pattern != it.pattern for g in group):
                group.append(it)
    runner = Runner(root, logdir, args.suite_timeout, args.heap, profiles,
                    venv_py, echo_py=args.jobs == 1)
    # PySpark tests needing sql/core's test classes skip without them (or run
    # stale ones); CI builds Test/package for the same reason.
    build_cmd = runner.sbt("package", *(["sql/Test/compile"] if py_items else []))
    all_cmd = runner.sbt("all " + " ".join(f"{it.module}/test" for it in mod_items))

    (logdir / "plan.txt").write_text(
        "".join(f"{it.name()}\t{it.why}\n" for it in items))
    say(f"plan: {'skip ' if args.skip_build else ''}build + {len(items)} suite(s), "
        f"profiles {' '.join(profiles)} [full list: {logdir / 'plan.txt'}]:")
    for it in items[:60]:
        extra = f"  env={it.env_extra}" if it.env_extra else ""
        say(f"  - {it.name():60s} (from {it.why}){extra}")
    if len(items) > 60:
        say(f"  ... and {len(items) - 60} more")

    if args.dry_run:
        say("dry run, would execute:")
        if not args.skip_build:
            say(f"  + {' '.join(build_cmd)}")
        if mod_items:
            say(f"  + {' '.join(all_cmd)}")
        for it in items:
            if it.pattern != "--all--":
                say(f"  + {' '.join(it.cmd(runner))}")
        return 0

    env_checks(root, venv_py, bool(py_items))

    def on_signal(signum, frame):
        say(f"got signal {signum}, killing running steps and stopping")
        runner.kill_all()
        sys.exit(128 + signum)

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    started = time.time()
    if not args.skip_build:
        say(f"=== phase 1: build ({' '.join(build_cmd)}) ===")
        rc, _ = runner.run(build_cmd, logdir / "build.log", runner.env,
                           timeout=3 * 3600)
        if rc != 0:
            say(f"BUILD FAILED (rc={rc}); not running tests against a stale jar. "
                f"See {logdir}/build.log")
            return 2
        say("build: OK")
        if args.build_only:
            return 0
    else:
        say("=== phase 1: build SKIPPED (--skip-build); jar had better be current ===")

    say(f"=== phase 2: {len(items)} suite(s), full runs, keep going on failure, "
        f"up to {args.jobs} at a time ===")

    def scala_unit():
        # All sbt work, in order, in ONE lane: two sbt processes in one
        # worktree would race on compile output.
        res = []
        if mod_items:
            res += run_scala_modules(runner, modules, mod_items, logdir, runner.env)
        for mod, group in scala_groups.items():
            name = (group[0].name() if len(group) == 1
                    else f"{mod}/batched-{len(group)}-suites")
            logfile = logdir / (safe_name(name) + ".log")
            status, timed_out = run_scala_batch(
                runner, mod, [it.pattern for it in group], logfile, runner.env)
            batch = Item("scala", mod,
                         group[0].pattern if len(group) == 1 else "--batch--",
                         f"{len(group)} diff-derived suite(s) in {mod}")
            batch.unrun = [p for p, s in status.items() if s == "unrun"]
            failed = any(s == "failed" for s in status.values())
            res.append((batch, 1 if failed else 0, timed_out, logfile))
        return res

    def py_unit(it):
        logfile = logdir / (safe_name(it.name()) + ".log")
        rc, timed_out = run_py(runner, it, logfile)
        if rc != 0 and not timed_out and not it.doctest \
                and not parse_py_failures(logfile):
            # The process died before reporting a test (or the module did not
            # import): one do-over before phase 3 has nothing to retry.
            say(f"{it.name()}: rc={rc} with no parsed failure; one do-over")
            rc, timed_out = run_py(runner, it, logfile)
        return [(it, rc, timed_out, logfile)]

    units = [(0, scala_unit)] if mod_items or scala_groups else []
    units += [(1 if it.pattern.startswith(HEAVY_PY) else 2,
               lambda it=it: py_unit(it)) for it in py_items]
    suite_results = [r for rs in run_lanes(units, args.jobs) for r in rs]

    say("=== phase 3: re-run each failed test individually ===")
    flakes, real, not_retried = [], [], []
    scala_retries, py_retries = [], []
    for it, rc, timed_out, logfile in suite_results:
        for p in it.unrun:
            not_retried.append((it, f"never finished (aborted, hung or timed "
                                    f"out): {p}", logfile))
        if rc == 0:
            continue
        if it.kind == "scala":
            failed, suite_level, compile_failed = parse_scala_failures(logfile)
            if compile_failed:
                not_retried.append((it, "compile failed", logfile))
                continue
            retry_specs = [(f"*{s.split('.')[-1]}", t, f"{s}::{t}") for s, t in failed]
            for s in suite_level:
                # failed carries the header's simple name, suite_level the
                # FQCN from sbt's "Failed tests:" summary -- same suite,
                # different strings, so compare on the simple name or every
                # failed suite gets retried twice (per-test AND whole-suite).
                if not any(s.rsplit(".", 1)[-1] == fs.rsplit(".", 1)[-1]
                           for fs, _ in failed):
                    retry_specs.append((f"*{s.split('.')[-1]}", None, s))
        elif it.doctest:
            # Doctests have no per-test name to retry: the module goes again.
            retry_specs = [(None, it.pattern, it.pattern)]
        else:
            retry_specs = []
            for mc, t in parse_py_failures(logfile):
                # Fixtures are not runnable test names -- "unittest
                # module.Class.setUpClass" errors out and the retry would
                # report a real failure. A fixture failure belongs to the
                # whole class (or module, when mc is bare).
                if t in ("setUpClass", "tearDownClass",
                         "setUpModule", "tearDownModule"):
                    retry_specs.append((None, mc, mc))
                else:
                    retry_specs.append((None, f"{mc}.{t}", f"{mc}.{t}"))
        # The combined batch log can name the same test once per round.
        retry_specs = list(dict.fromkeys(retry_specs))
        if not retry_specs:
            if timed_out:
                not_retried.append((it, "timed out", logfile))
            else:
                not_retried.append((it, "failed with no parseable test names", logfile))
            continue
        if it.kind == "scala":
            scala_retries.append((it, retry_specs))
        else:
            py_retries += [(it, test, label) for _, test, label in retry_specs]

    # Exactly one retry, deliberately not a knob: a test that fails twice is
    # a thing to look at, not to re-roll until it passes.
    def scala_retry_unit():
        out = []
        for it, specs in scala_retries:
            pats = {}
            for suite_glob, test, label in specs:
                safe = (test or "").replace('"', '\\"')
                pats[label] = (f'{suite_glob} -- -z "{safe}"' if test is not None
                               else suite_glob)
            rlog = logdir / ("retry-" + safe_name(it.name())[:120] + ".log")
            status, _ = run_scala_batch(runner, it.module, list(pats.values()),
                                        rlog, runner.env, retry=True)
            out += [(it, label, status.get(p, "unrun"), rlog)
                    for label, p in pats.items()]
        return out

    def py_retry_unit(it, test, label):
        retry = Item("py", None, test, it.why, it.env_extra, it.doctest)
        rlog = logdir / ("retry-" + safe_name(label)[:120] + ".log")
        rc, _ = run_py(runner, retry, rlog)
        return [(it, label, "ok" if rc == 0 else "failed", rlog)]

    units = [(0, scala_retry_unit)] if scala_retries else []
    units += [(1, lambda r=r: py_retry_unit(*r)) for r in py_retries]
    for it, label, state, rlog in (r for rs in run_lanes(units, args.jobs) for r in rs):
        if state == "ok":
            flakes.append((it, label))
            say(f"FLAKE: {label} (failed in the suite run, passed on retry)")
        elif state == "failed":
            real.append((it, label, rlog))
            say(f"REAL FAILURE: {label} (failed twice -- suite run and retry)")
        else:
            not_retried.append((it, f"retry never ran: {label}", rlog))

    say("=== summary ===")
    elapsed = int(time.time() - started)
    green = sum(1 for it, rc, _, _ in suite_results if rc == 0 and not it.unrun)
    lines = [
        f"worktree: {root}  branch: {branch}  base: {base}",
        f"build: {'skipped' if args.skip_build else 'OK'}",
        f"suites: {len(items)} in {len(suite_results)} run(s), "
        f"{green} green first try, "
        f"{len(suite_results) - green} needed a second look",
        f"flakes (failed, then passed on retry): {len(flakes)}",
    ]
    lines += [f"  FLAKE {it.name()} :: {label}" for it, label in flakes]
    lines.append(f"real failures: {len(real)}")
    lines += [f"  FAIL {it.name()} :: {label} [{lg}]" for it, label, lg in real]
    if not_retried:
        lines.append(f"not retried: {len(not_retried)}")
        lines += [f"  ??? {it.name()} ({why}) [{lg}]" for it, why, lg in not_retried]
    lines.append(f"logs: {logdir}")
    lines.append(f"elapsed: {elapsed // 60}m{elapsed % 60:02d}s")
    for l in lines:
        say(l)
    (logdir / "summary.txt").write_text("\n".join(lines) + "\n")

    if real or not_retried:
        say("RESULT: RED -- fix the real failures before pushing")
        return 1
    if flakes:
        say("RESULT: GREEN with flakes -- pushable, but the flakes above are worth a look")
        return 0
    say("RESULT: GREEN")
    return 0


if __name__ == "__main__":
    sys.exit(main())
