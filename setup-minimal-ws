#!/bin/bash
# Minimal workstation bootstrap: just the shared core (distro packages, git
# identity, docker, ~/bin, agent configs, franktheunicorn tools). The full
# desktop setup (conda, sbt, OBS, mypackages, ...) is ./setup-full.
set -euo pipefail
source "$(dirname "$0")/setup-shared"

# Trace off first, same as setup-full: the point of the replay is that the
# warnings are the last thing on the screen, not more xtrace clutter.
set +x
setup_replay_warnings
